
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * CRICKET ORACLE SECURITY RULES
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return resource != null && isOwner(userId);
    }

    match /users/{userId} {
      // Allow public read access for the leaderboard and profile viewing
      allow read: if true;
      
      // Only the user can manage their own profile, 
      // EXCEPT for the shared 'universal_guest' account which is community-owned.
      allow create: if isOwner(userId) || (userId == 'universal_guest' && isSignedIn());
      
      // Update logic: 
      // 1. Owner can update everything
      // 2. Shared 'universal_guest' can be updated by any signed-in user (Community Sync)
      // 3. Anyone signed in can update ANY user's 'totalPoints' or 'accuracy' for leaderboard accuracy
      allow update: if isExistingOwner(userId) 
                    || (userId == 'universal_guest' && isSignedIn())
                    || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalPoints', 'accuracy']));
      
      allow delete: if isExistingOwner(userId);

      match /predictions/{predictionId} {
        allow read: if true;
        allow list: if true;
        
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
        allow update: if isExistingOwner(userId);
        allow delete: if isExistingOwner(userId);
      }
    }

    match /cricketSeries/{seriesId} {
      allow get, list: if true;
      allow write: if isSignedIn();

      match /matches/{matchId} {
        allow get, list: if true;
        allow write: if false; 
      }
    }
  }
}
