
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * CRICKET ORACLE SECURITY RULES
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return resource != null && isOwner(userId);
    }

    // Special case for the shared guest account
    function isUniversalGuest(userId) {
      return userId == 'universal-guest' && isSignedIn();
    }

    match /users/{userId} {
      // Allow public read access for the leaderboard and profile viewing
      allow read: if true;
      
      // Only the user can manage their own profile, OR any signed-in user can manage the universal guest
      allow create: if isOwner(userId) || isUniversalGuest(userId);
      
      // Update logic: 
      // 1. Owner can update everything
      // 2. Anyone signed in can update the universal guest
      // 3. Anyone signed in can update ANY user's 'totalPoints' or 'accuracy' to keep the leaderboard accurate (Community Sync)
      allow update: if isExistingOwner(userId) 
                    || isUniversalGuest(userId)
                    || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalPoints', 'accuracy']));
      
      allow delete: if isExistingOwner(userId);

      match /predictions/{predictionId} {
        allow read: if true;
        allow list: if true;
        
        allow create: if (isOwner(userId) && request.resource.data.userId == userId) || isUniversalGuest(userId);
        allow update: if isExistingOwner(userId) || isUniversalGuest(userId);
        allow delete: if isExistingOwner(userId);
      }
    }

    match /cricketSeries/{seriesId} {
      allow get, list: if true;
      allow write: if isSignedIn();

      match /matches/{matchId} {
        allow get, list: if true;
        allow write: if false; 
      }
    }
  }
}
